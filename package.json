{
  "name": "dsh-pet-control",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "小深：DeepSeek Harness 的 macOS 桌面小助手。侧栏一键打开/关闭，Harness 关掉后它仍然留在桌面上。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/DETAIL.md",
    "pet/pet.py",
    "pet/brain.py",
    "LICENSE",
    "README.md",
    "pet/run.command",
    "pet/skins/*.json",
    "pet/skins/README.md",
    "pet/companions/*.png",
    "pet/companions/*.json",
    "pet/companions/README.md",
    "pet/make_companions.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarondyl/dsh-desktop-pet.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "macos"
  ],
  "os": [
    "darwin"
  ]
}
